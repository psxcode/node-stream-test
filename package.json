{
  "name": "node-stream-test",
  "version": "0.4.0",
  "type": "module",
  "sideEffects": false,
  "files": ["build"],
  "main": "build/index.js",
  "typings": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "license": "MIT",
  "author": "psxcode <psxcode@gmail.com> (https://github.com/psxcode)",
  "homepage": "https://github.com/psxcode/node-stream-test",
  "scripts": {
    "test": "node --test --experimental-test-coverage test/*.spec.ts",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"fs.rmSync('build',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "copy": "cp package.json LICENSE readme.md build/",
    "lint": "oxlint",
    "fmt": "oxfmt --write src test",
    "fmt:check": "oxfmt --check src test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "iterama": "^0.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  }
}
